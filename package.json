{
  "name": "wowget",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile src/cli.ts --outfile dist/wowget",
    "build:mac": "bun build --compile --target=bun-darwin-arm64 src/cli.ts --outfile dist/wowget",
    "build:win": "bun build --compile --target=bun-windows-x64 src/cli.ts --outfile dist/wowget.exe",
    "build:release": "bun scripts/build-release.ts",
    "registry:check": "bun scripts/check-registry.ts"
  },
  "dependencies": {
    "@opentui/core": "0.8.2",
    "@opentui/react": "0.8.2",
    "fflate": "^0.8.3",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "19.3.0",
    "typescript": "^7.0.2"
  }
}
