{
  "name": "wowget",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build --compile src/cli.ts --outfile dist/wowget",
    "build:mac": "bun build --compile --target=bun-darwin-arm64 src/cli.ts --outfile dist/wowget",
    "build:win": "bun build --compile --target=bun-windows-x64 src/cli.ts --outfile dist/wowget.exe"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^5.9.3"
  }
}
