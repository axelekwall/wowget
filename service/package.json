{
  "name": "wowget-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "registry": "node scripts/build-registry.ts",
    "dev": "wrangler dev",
    "typecheck": "node scripts/build-registry.ts && tsc --noEmit",
    "test": "node scripts/build-registry.ts && vitest run",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "catalogue:import": "node scripts/import-catalogue.ts"
  },
  "dependencies": {
    "hono": "4.13.19",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.1",
    "@cloudflare/workers-types": "5.20261112.1",
    "@types/node": "26.6.4",
    "smol-toml": "1.9.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "wrangler": "4.161.0"
  }
}
